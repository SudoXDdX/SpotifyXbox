<Page
    x:Class="SpotifyXbox.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#121212">

    <Grid Padding="48,48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16">
            <Border Width="64" Height="64" CornerRadius="32" Background="#1DB954">
                <TextBlock Text="♪" FontSize="32" Foreground="Black"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Spotify" FontSize="40" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="SudoXD Edition — Xbox Dev Mode" FontSize="16" Foreground="#B3B3B3"/>
            </StackPanel>
        </StackPanel>

        <!-- Login / User info -->
        <StackPanel Grid.Row="1" Margin="0,24,0,8" Orientation="Horizontal" Spacing="12">
            <Button x:Name="LoginButton" Content="Entrar com Spotify" FontSize="18"
                    Background="#1DB954" Foreground="Black" Padding="24,12"
                    Click="OnLoginClick"/>
            <TextBlock x:Name="UserText" Foreground="#B3B3B3" FontSize="16" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Lista principal -->
        <ScrollViewer Grid.Row="2" Margin="0,8">
            <ListView x:Name="TrackList" SelectionMode="Single"
                      IsItemClickEnabled="True" ItemClick="OnTrackClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12" Background="#181818" Margin="4" CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="18" Foreground="White"/>
                                <TextBlock Text="{Binding Artist}" FontSize="14" Foreground="#B3B3B3"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="♪ 30s" FontSize="12" Foreground="#1DB954"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!-- Player bar -->
        <Grid Grid.Row="3" Background="#181818" Padding="24,16" CornerRadius="12" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="NowPlaying" Text="Nada tocando" FontSize="18" Foreground="White"/>
                <TextBlock x:Name="NowArtist" Text="" FontSize="13" Foreground="#B3B3B3"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                <Button x:Name="PrevButton" Content="⏮" FontSize="24" Background="#282828"
                        Foreground="White" Click="OnPrevClick" Padding="16,8"/>
                <Button x:Name="PlayButton" Content="▶" FontSize="24" Background="#1DB954"
                        Foreground="Black" Click="OnPlayClick" Padding="16,8"/>
                <Button x:Name="NextButton" Content="⏭" FontSize="24" Background="#282828"
                        Foreground="White" Click="OnNextClick" Padding="16,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
