<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  IgnorableNamespaces="uap mp uap5">

  <Identity
    Name="SudoXD.SpotifyXbox"
    Publisher="CN=SudoXD"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="8f2a3c4d-5e6f-4a5b-9c8d-7e6f5a4b3c2d" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Spotify (SudoXD Edition)</DisplayName>
    <PublisherDisplayName>SudoXD</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- x-generate e' diretiva do PriGen do VS (build-time). No empacotamento
       manual via makeappx as linguagens tem que ser explicitas — o Xbox Dev
       Mode rejeita 'x-generate' no registro (0x80070057). -->
  <Resources>
    <Resource Language="en-US"/>
    <Resource Language="pt-BR"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="SpotifyXbox.exe"
      EntryPoint="SpotifyXbox.App">
      <uap:VisualElements
        DisplayName="Spotify (SudoXD Edition)"
        Description="Player Spotify com Connect remoto e previews, feito pro Xbox Dev Mode"
        BackgroundColor="#1DB954"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <!-- Background audio: o app usa MediaPlayer + SMTC in-process
           (SystemMediaTransportControls via MediaPlayer.CommandManager).
           A declaracao uap5/windows.backgroundTasks de EntryPoint
           BackgroundAudioTask apontava pra uma classe que NAO EXISTE no
           source — removida: sem ela o manifest valida e o SMTC continua
           funcionando in-process. -->
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
